# Signal-to-Trade Bridge -- example environment file.
#
# Copy to `.env` and edit. The copy is gitignored; this file is not, and must
# never contain a real credential.
#
#     cp .env.example .env
#
# Every variable this project reads carries the BRIDGE_ prefix. The execution
# project uses a separate AUTO_TRADE_ prefix for its own 23 settings, and the
# bridge reads none of them -- several of its defaults are absolute paths on a
# different machine, which is exactly the coupling this prefix avoids.
#
# Parsed by a deliberately minimal reader: KEY=VALUE, # comments, optional
# `export` prefix, optional quotes. No variable expansion. A real environment
# variable always beats this file, so you can override anything for one command
# without editing it.


# ============================================================================
# RISK
# ============================================================================

# Percentage of account balance to risk per trade.
#
# 0.5 is the project's starting configuration. 0.25, 0.75 and 1.0 are all
# configuration changes and need no code change. Values above 100 are refused:
# they would mean risking the account more than once over.
BRIDGE_RISK_PERCENT=0.5

# Target reward divided by risk. 1.0 means 1:1, so the reward distance equals
# the risk distance.
#
# This is the distance the bridge *derives*. It is NOT a floor on the signal's
# own target -- see BRIDGE_MINIMUM_REWARD_RISK_RATIO below for that.
BRIDGE_REWARD_RISK_RATIO=1.0

# The minimum reward:risk a signal's own target must clear to be used.
#
# Leave it unset (the default) and any structurally sound target is taken as the
# engine measured it, however poor the ratio. Set it to the same value as
# BRIDGE_REWARD_RISK_RATIO to get the behaviour most people assume RR_FALLBACK
# already has -- "the engine's target is usually better than mine, but I want 1:1
# as the floor".
#
# Off by default on purpose: turning it on starts replacing engine-measured
# targets with the configured distance, which is a trading decision and not a
# bridge upgrade. When it applies, the substitution is recorded in the decision
# log as a fallback with the ratio that was found.
#
# Filters the signal's target only. Under RR_DERIVED there is nothing to filter.
# A value of 0 is refused rather than treated as "unset", because a floor of zero
# refuses every target and would look like a typo that nobody notices for a day.
# BRIDGE_MINIMUM_REWARD_RISK_RATIO=

# Where the take profit comes from.
#
#   RR_FALLBACK  use the signal's own target when it is structurally defensible,
#                above the configured minimum ratio, and on the correct side of
#                entry; otherwise apply BRIDGE_REWARD_RISK_RATIO. A fallback is
#                always recorded in the decision log; it is never silent.
#   SIGNAL       use the signal's own target, and refuse the trade if it is
#                unusable. Strictest option.
#   RR_DERIVED   ignore signal targets entirely and always apply the ratio.
#   NONE         no take profit. Only valid if you manage exits yourself.
#
# The upstream engine's targets carry a basis, and a `MEASURED_MOVE` or `SWING`
# target is a level the market produced while an `ATR_FALLBACK` is a volatility
# multiple. This setting decides which of those you trust.
BRIDGE_TAKE_PROFIT_SOURCE=RR_FALLBACK

# Allow a stop that the engine derived from a volatility multiple rather than
# from a structural level the market actually produced.
#
# FALSE by default, and the default is the point. The engine's own documentation
# calls such a plan "arithmetically sound and structurally empty". The brief says
# not to invent a stop merely to make the system trade, and this is the switch
# that would let it. Turn it on only if you have decided that a volatility stop
# is acceptable to you, and expect `STOP_RESOLVED` to record that it was used.
BRIDGE_ALLOW_VOLATILITY_FALLBACK_STOP=false

# Minimum evidence score for a signal to be considered, 0..1. Leave unset to
# disable the filter.
#
# THIS IS NOT A PROBABILITY OF WINNING. The upstream engine is explicit about
# this in its own output: the number is a concentration of evidence, not a
# continuation chance, and no threshold on it has been validated against
# outcomes. The name is `evidence_score` for that reason -- the brief's suggested
# `minimum_signal_confidence` was rejected during the architecture audit because
# the name invites exactly the misreading the number cannot support.
# BRIDGE_MINIMUM_EVIDENCE_SCORE=0.6


# ============================================================================
# POLICY
# ============================================================================

# Restrict the bridge to one direction. Both false is refused at startup, because
# a bridge that can never trade is indistinguishable from one that is broken.
BRIDGE_ALLOW_BUY=true
BRIDGE_ALLOW_SELL=true

# Symbols this bridge will trade, comma separated. Leave unset for no
# restriction from the bridge.
#
# This is NOT a safety control. The execution project has its own allowlist and
# applies it independently, so a signal must satisfy both. This list exists to
# narrow what the bridge will even try to size.
# BRIDGE_ALLOWED_SYMBOLS=EURUSD,XAUUSD

# Refuse a tradable signal when the spread is at or above this many price units.
# In price units, not points, so it means the same thing on a 5-digit forex pair
# and on gold quoted to 2 decimals. Unset disables the check.
#
# The Phase 1 domain carries the setting; the spread itself is read by the MT5
# adapter in Phase 7, so the check activates then.
# BRIDGE_MAX_SPREAD=0.00030

# Refuse a new trade at or above this many open positions. Unset disables.
# BRIDGE_MAX_OPEN_POSITIONS=3


# ============================================================================
# EXECUTION
# ============================================================================

# Master switch. FALSE by default, and a fresh checkout therefore cannot trade.
#
# This is checked in the bridge's own decision path, before the executor is
# reached, and is independent of any switch the execution project has. The two
# are separate on purpose: there should never be a configuration in which the
# bridge believes it may trade while the execution layer believes it may not, or
# the reverse.
BRIDGE_EXECUTION_ENABLED=false

# Produce the full decision, log it, and stop before the executor.
#
# A dry run short-circuits inside the bridge, so no downstream setting can cause
# an order while it is on. It is checked together with BRIDGE_EXECUTION_ENABLED
# and overrides it: a configuration with execution enabled and dry run on is a
# dry run, regardless of which value you changed last.
BRIDGE_DRY_RUN=true

# Refuse to start unless the MetaTrader terminal is already running and logged
# in. The bridge never launches it, because a process that can start a trading
# terminal can start one by accident.
BRIDGE_REQUIRE_RUNNING_TERMINAL=true

# Where the execution project's audit log and idempotency ledger live. Relative
# to the working directory, so it is portable; absolute if you prefer.
BRIDGE_LOG_DIR=logs


# ============================================================================
# ENVIRONMENT
# ============================================================================

# Path to terminal64.exe. Leave unset to let the MetaTrader bindings find it.
#
# Set it when the machine has more than one terminal installed, because the
# bindings then have to guess and a guess that picks the wrong instance reads the
# wrong account. On the development machine:
# BRIDGE_MT5_TERMINAL_PATH=C:\Users\<you>\AppData\Roaming\Alpari MT5\terminal64.exe

# The terminal's data directory, where the MQL5 file bridge and the
# position-snapshot indicator write. Required for live validation in Phase 11.
# BRIDGE_MT5_DATA_PATH=C:\Users\<you>\AppData\Roaming\MetaQuotes\Terminal\<instance-hash>

# Bars requested per analysis. The upstream pipeline works over a fixed-length
# window, and a window too short produces no reading rather than a worse one.
BRIDGE_BAR_COUNT=300

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
BRIDGE_LOG_LEVEL=INFO

# Emit one JSON object per event instead of human-readable lines. Turn this on
# when you want to query the decision log rather than read it.
BRIDGE_LOG_JSON=false


# ============================================================================
# SECRETS
# ============================================================================
#
# The bridge does not need a broker password and will not accept one. It never
# logs in to the terminal: it connects to a terminal that is already running and
# already authenticated, and the execution project refuses to act unless the
# window is identified as a demo account.
#
# The redaction list in the logger covers token, password, secret, api_key,
# credential, authorization and similar names, so a value that arrives in a
# field with one of those names is replaced with ***redacted*** before it can
# reach a log file. That is a backstop, not a licence to put a credential in a
# configuration file. Do not add one.
#
# This file must never contain a real secret. `.env` is gitignored; `.env.example`
# is committed, and anything added here ends up in the repository.
